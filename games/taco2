local function scanAndClaimQuests()
    if not Config.AutoClaimQuestsEnabled then return end
    
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui") or PlayerGui
        if not pg then return end
        
        -- 1. Scan UI buttons for "Claim" (Quests, Daily Fountain Rewards, Group Rewards)
        for _, desc in ipairs(pg:GetDescendants()) do
            if desc:IsA("GuiButton") then
                local isClaimBtn = false
                local rewardDesc = "Reward"
                
                if desc:IsA("TextButton") and typeof(desc.Text) == "string" and desc.Text:lower():match("^claim") then
                    isClaimBtn = true
                end
                
                if not isClaimBtn then
                    for _, child in ipairs(desc:GetDescendants()) do
                        if child:IsA("TextLabel") and typeof(child.Text) == "string" and child.Text:lower():match("^claim") then
                            isClaimBtn = true
                            break
                        end
                    end
                end
                
                -- Jangan pernah klik tombol Skip
                if desc:IsA("TextButton") and typeof(desc.Text) == "string" and desc.Text:lower():match("^skip") then
                    isClaimBtn = false
                end
                
                if isClaimBtn then
                    -- Ambil nama/keterangan hadiah jika ada
                    local parentRow = desc.Parent
                    if parentRow then
                        for _, lbl in ipairs(parentRow:GetDescendants()) do
                            if lbl:IsA("TextLabel") and typeof(lbl.Text) == "string" and lbl.Text ~= "" 
                               and not lbl.Text:lower():match("claim") 
                               and not lbl.Text:lower():match("skip")
                               and not lbl.Text:lower():match("easy") 
                               and not lbl.Text:lower():match("medium") 
                               and not lbl.Text:lower():match("hard") 
                               and not lbl.Text:find("%d+/%d+") then
                                rewardDesc = lbl.Text
                                break
                            end
                        end
                    end
                    
                    clickGuiButton(desc)
                    addLog("🎁 Claimed: " .. string.sub(rewardDesc, 1, 20))
                    task.wait(0.15)
                end
            end
        end
        
        -- 2. Scan Milestone / Exclusive Badges scroll bar di bagian bawah Quest popup
        for _, desc in ipairs(pg:GetDescendants()) do
            if desc:IsA("GuiButton") then
                local nameLower = desc.Name:lower()
                if nameLower:find("badge") or nameLower:find("milestone") or nameLower:find("scroll") then
                    local canClaim = false
                    pcall(function()
                        if desc:GetAttribute("Claimable") == true or desc:GetAttribute("CanClaim") == true then
                            canClaim = true
                        end
                    end)
                    if canClaim then
                        clickGuiButton(desc)
                        addLog("🎖️ Claimed Badge Milestone!")
                        task.wait(0.15)
                    end
                end
            end
        end
    end)
    
    -- 3. Cek RemoteEvent / RemoteFunction jika tersedia di ReplicatedStorage
    pcall(function()
        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
            if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                local rName = remote.Name:lower()
                if (rName:find("claim") and (rName:find("quest") or rName:find("daily") or rName:find("group") or rName:find("reward"))) then
                    pcall(function()
                        if remote:IsA("RemoteEvent") then
                            remote:FireServer()
                            for i = 1, 10 do
                                remote:FireServer(i)
                                remote:FireServer("Daily", i)
                                remote:FireServer("Weekly", i)
                                remote:FireServer("Monthly", i)
                            end
                        end
                    end)
                end
            end
        end
    end)
end

