local function mkToggleCard(title, desc, initial, onToggle, order, accentColor)
    local card = Instance.new("TextButton")
    card.Size = UDim2.new(1, 0, 0, 48)
    card.BackgroundColor3 = C.CARD
    card.AutoButtonColor = false
    card.Text = ""
    card.LayoutOrder = order or 10
    card.Parent = Content
    mkCorner(card, 8)
    local activeCol = accentColor or C.ACCENT
    local stroke = mkStroke(card, initial and activeCol or C.BORDER, 1)
    
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -55, 0, 18)
    t.Position = UDim2.new(0, 10, 0, 6)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = C.TEXT
    t.TextSize = 11
    t.Font = Enum.Font.GothamBold
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = card
    
    local d = Instance.new("TextLabel")
    d.Size = UDim2.new(1, -55, 0, 16)
    d.Position = UDim2.new(0, 10, 0, 24)
    d.BackgroundTransparency = 1
    d.Text = desc
    d.TextColor3 = C.TEXT_MUTED
    d.TextSize = 9
    d.Font = Enum.Font.Gotham
    d.TextXAlignment = Enum.TextXAlignment.Left
    d.Parent = card
    
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 36, 0, 20)
    sw.Position = UDim2.new(1, -44, 0.5, -10)
    sw.BackgroundColor3 = initial and C.GREEN or C.BORDER
    sw.Parent = card
    mkCorner(sw, 10)
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = initial and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = sw
    mkCorner(knob, 8)
    
    local state = initial
    local function set(newState)
        state = newState
        local targetColor = state and C.GREEN or C.BORDER
        local targetKnobPos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        TweenService:Create(sw, TweenInfo.new(0.15), { BackgroundColor3 = targetColor }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), { Position = targetKnobPos }):Play()
        stroke.Color = state and activeCol or C.BORDER
        onToggle(state)
    end
    
    card.Activated:Connect(function() set(not state) end)
    return { Set = set, Get = function() return state end }
end

