    pcall(function()
        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
            if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                local rName = remote.Name:lower()
                if rName:find("code") or rName:find("redeem") or rName:find("promo") then
                    pcall(function()
                        if remote:IsA("RemoteEvent") then
                            remote:FireServer(code)
                            remote:FireServer("Redeem", code)
                            remote:FireServer({ Code = code })
                        elseif remote:IsA("RemoteFunction") then
                            task.spawn(function()
                                pcall(function() remote:InvokeServer(code) end)
                            end)
                        end
                    end)
                end
            end
        end
    end)
    
    -- Method 2: GUI TextBox & Submit Button Injection
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui") or PlayerGui
        if not pg then return end
        
        for _, tb in ipairs(pg:GetDescendants()) do
            if tb:IsA("TextBox") then
                local tbName = tb.Name:lower()
                local phText = typeof(tb.PlaceholderText) == "string" and tb.PlaceholderText:lower() or ""
                
                if tbName:find("code") or phText:find("code") or phText:find("enter") then
                    tb.Text = code
                    
                    pcall(function()
                        if firesignal and tb.FocusLost then
                            firesignal(tb.FocusLost, true)
                        end
                    end)
                    
                    local parent = tb.Parent
                    if parent then
                        for _, btn in ipairs(parent:GetDescendants()) do
                            if btn:IsA("GuiButton") and btn ~= tb then
                                local bText = ""
                                if btn:IsA("TextButton") and typeof(btn.Text) == "string" then
                                    bText = btn.Text:lower()
                                else
                                    local l = btn:FindFirstChildWhichIsA("TextLabel")
                                    if l and typeof(l.Text) == "string" then bText = l.Text:lower() end
