local function getValidDoors()
    local doors = CollectionService:GetTagged("TrickOrTreatDoor")
    local readyDoors = {}
    local now = workspace:GetServerTimeNow()
    
    for _, door in ipairs(doors) do
        if door:IsA("BasePart") then
            local readyAt = doorCooldowns[door] or 0
            if now >= readyAt then
                table.insert(readyDoors, door)
            end
        end
    end
    return readyDoors, doors
end

local isWalkingToDoor = false
local function runTrickOrTreatStep()
    if isWalkingToDoor then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    
    local readyDoors, allDoors = getValidDoors()
    if #readyDoors == 0 then
        return
    end
    
    -- Pilih pintu terdekat yang ready
    table.sort(readyDoors, function(a, b)
        return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
    end)
    
    local targetDoor = readyDoors[1]
    local frontUnit = targetDoor:GetAttribute("TrickOrTreatFront")
    local targetPos = targetDoor.Position
    if typeof(frontUnit) == "Vector3" then
        targetPos = targetDoor.Position + frontUnit * 3.5
    else
        targetPos = targetDoor.Position + targetDoor.CFrame.LookVector * 3.5
    end
    
    isWalkingToDoor = true
    addLog("TRICK-OR-TREAT", "Menuju ke pintu: " .. targetDoor.Name .. " (" .. math.floor((targetPos - hrp.Position).Magnitude) .. " studs)", Theme.TextSecondary)
    
    -- Smooth Anti-Cheat Safe Glide (Max 48 studs/s untuk melewati batas 60 studs/s AntiCheat)
    local moveThread = task.spawn(function()
        local SAFE_SPEED = 48
        
        -- Aktifkan noclip sementara saat menuju pintu
        local noclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
        
        while State.AutoTrickOrTreat and LocalPlayer.Character do
            local currentHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not currentHrp then break end
            
            local diff = targetPos - currentHrp.Position
            local dist = diff.Magnitude
            if dist <= 5 then
                break
            end
            
            local stepDist = math.min(dist, SAFE_SPEED * 0.05)
            local nextPos = currentHrp.Position + (diff.Unit * stepDist)
            currentHrp.CFrame = CFrame.new(nextPos, nextPos + diff.Unit)
            currentHrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.05)
        end
        
        if noclipConn then noclipConn:Disconnect() end
        
        -- Tunggu di depan pintu agar server proximity loop men-trigger Knock
        local waitStart = tick()
        while State.AutoTrickOrTreat and (tick() - waitStart) < 3.0 do
            local now = workspace:GetServerTimeNow()
            if (doorCooldowns[targetDoor] or 0) > now then
                break -- Berhasil knock terdeteksi
            end
            task.wait(0.25)
        end
        
        -- Set cooldown lokal sebagai fallback
        doorCooldowns[targetDoor] = workspace:GetServerTimeNow() + 30.5
        isWalkingToDoor = false
    end)
end

-- [FEATURE 5: AUTO CLAIM HALLOWEEN QUESTS]
local function claimHalloweenQuests()
    if not Remotes.ClaimHalloweenQuest or not DataController or not DataController.Halloween then return end
    
    local periods = { "Hourly", "Daily" }
    for _, period in ipairs(periods) do
        local key = period == "Hourly" and "HourlyQuests" or "Quests"
        if DataController.Halloween[key] then
            local questData = DataController.Halloween[key]()
            if questData and questData.ids then
                for _, qId in ipairs(questData.ids) do
                    local isClaimed = questData.claimed and questData.claimed[qId] == true
                    if not isClaimed then
                        pcall(function()
                            Remotes.ClaimHalloweenQuest:FireServer(period, qId)
                        end)
                        addLog("HALLOWEEN QUEST", "Mencoba klaim " .. period .. " Quest: " .. qId, Theme.Purple)
                        task.wait(0.25)
                    end
                end
            end
        end
    end
end

