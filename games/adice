        end
        
        -- 3. Auto Teleport Halloween (cek posisi setiap 5 detik)
        if State.AutoTeleportHalloween and (now - islandTimer) >= 5.0 then
            islandTimer = now
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local arrival = workspace:FindFirstChild("Halloween") and workspace.Halloween:FindFirstChild("ArrivalPoint")
            if hrp and arrival then
                local dist = (hrp.Position - arrival.Position).Magnitude
                if dist > 850 then -- Jika player di luar Halloween Island
                    teleportToHalloweenIsland()
                end
            else
                teleportToHalloweenIsland()
            end
        end
        
        -- 4. Auto Trick or Treat (continuous queue)
        if State.AutoTrickOrTreat then
            runTrickOrTreatStep()
        end
        
        -- 5. Auto Claim Halloween Quests & Pumpkin Pass (setiap 10 detik)
        if (now - passTimer) >= 10.0 then
            passTimer = now
            if State.AutoClaimPumpkinPass then
                claimPumpkinPass()
            end
            if State.AutoClaimHalloweenQuests then
                claimHalloweenQuests()
            end
        end
        
        -- 6. Auto Claim Daily Reward & Quests (setiap 15 detik)
        if (now - dailyTimer) >= 15.0 then
            dailyTimer = now
            if State.AutoClaimDailyReward then
                claimDailyLogin()
            end
            if State.AutoClaimQuests then
                claimNormalQuests()
            end
        end
    end
end)

