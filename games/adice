-- [FEATURE 7: AUTO CLAIM DAILY LOGIN]
local function claimDailyLogin()
    if not Remotes.ClaimDailyReward then return false end
    
    local canClaim = true
    if DataController and DataController.LastDailyRewardClaim then
        pcall(function()
            local lastClaim = DataController.LastDailyRewardClaim() or 0
            if lastClaim ~= 0 and (os.time() - lastClaim) < 82800 then
                canClaim = false
            end
        end)
    end
    
    if canClaim then
        pcall(function()
            Remotes.ClaimDailyReward:FireServer()
        end)
        addLog("DAILY REWARD", "Klaim Daily Login Reward dikirim!", Theme.Cyan)
        return true
    end
    return false
end

-- [FEATURE 8: AUTO CLAIM QUESTS (DAILY & WEEKLY)]
local function claimNormalQuests()
    if not Remotes.ClaimQuest or not DataController or not DataController.Quests then return end
    
    local periods = { "Daily", "Weekly" }
    for _, period in ipairs(periods) do
        if DataController.Quests[period] then
            local qData = DataController.Quests[period]()
            if qData and qData.progress and qData.expiresAt then
                for qId, prog in pairs(qData.progress) do
                    local isClaimed = qData.claimed and qData.claimed[qId] == true
                    if not isClaimed then
                        pcall(function()
                            Remotes.ClaimQuest:FireServer(period, qId, qData.expiresAt)
                        end)
                        task.wait(0.25)
                    end
                end
            end
        end
    end
end

