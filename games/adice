-- [FEATURE 1: AUTO COLLECT BASE MONEY]
local function collectBaseMoney()
    if not Remotes.CollectBalance then return false end
    local collectedAny = false
    
    -- Slot standard game: 1 to 18 (PlotConfig.GetMaxSlots())
    for slot = 1, 18 do
        local shouldCollect = true
        if DataController and DataController.Slots and DataController.Slots[tostring(slot)] then
            local slotInfo = DataController.Slots[tostring(slot)]()
            if not slotInfo or (slotInfo.balance and slotInfo.balance <= 0) then
                shouldCollect = false
            end
        end
        
        if shouldCollect then
            pcall(function()
                Remotes.CollectBalance:FireServer(slot)
            end)
            collectedAny = true
        end
    end
    return collectedAny
end

-- [FEATURE 2: AUTO REBIRTH]
local function executeRebirth()
    if not Remotes.Rebirth then return false end
    
    local curRebirth = 0
    local curMoney = 0
    if DataController then
        pcall(function()
            curRebirth = DataController.Rebirth() or 0
            curMoney = DataController.Money() or 0
        end)
    end
    
    local nextCost = RebirthCosts[curRebirth]
    if nextCost and curMoney < nextCost then
        return false -- Saldo belum mencukupi
    end
    
    local ok = pcall(function()
        Remotes.Rebirth:FireServer()
    end)
    
    if ok then
        addLog("REBIRTH", "Signal Rebirth dikirim (Target: +" .. (curRebirth + 1) .. ")", Theme.Green)
        return true
    end
    return false
end

