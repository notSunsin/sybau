                addLog("CONFIG", "Config otomatis dimuat dari workspace [" .. ConfigManager.FileName .. "]", Theme.Green)
            end
        else
            -- Buat file config pertama kali dengan default settings
            ConfigManager.Save(true)
            addLog("CONFIG", "Membuat config baru di workspace: " .. ConfigManager.FileName, Theme.TextSecondary)
        end
        updateConfigStatusUI()
    else
        addLog("CONFIG", "Menjalankan tanpa persistent config (writefile unsupported)", Theme.TextMuted)
    end
end)

