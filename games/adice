-- [FEATURE 4: AUTO TRICK OR TREAT]
local doorCooldowns = {}

if Remotes.KnockedEvent then
    pcall(function()
        Remotes.KnockedEvent.OnClientEvent:Connect(function(doorPart, outcomeIndex, readyAt)
            if doorPart then
                doorCooldowns[doorPart] = readyAt or (workspace:GetServerTimeNow() + 30)
                addLog("TRICK-OR-TREAT", "Pintu diketuk! Berhasil dapat Candy / Item!", Theme.Orange)
            end
        end)
    end)
