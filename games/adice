-- 5. CONFIG MANAGER (WORKSPACE FILE SYSTEM SAVE & AUTOLOAD)
-- =============================================================================
local ConfigManager = {
    FileName = "HUKI_AnimeDice_Config.json",
    RegisteredToggles = {},
    LastActionTime = "Belum pernah",
    StatusMessage = "Menunggu aksi...",
}

local function isFsSupported()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

function ConfigManager.RegisterToggle(key, setVisualFn, callbackFn)
    ConfigManager.RegisteredToggles[key] = {
        setVisual = setVisualFn,
        callback = callbackFn,
    }
end

function ConfigManager.Save(silent)
    if not isFsSupported() then
        if not silent then
            addLog("CONFIG", "Workspace file system (writefile) tidak didukung executor ini.", Theme.Red)
        end
        return false
    end
    
    local saveTable = {}
    for k, v in pairs(State) do
        saveTable[k] = v
    end
    saveTable["_SavedAt"] = os.date("%Y-%m-%d %H:%M:%S")
    
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(saveTable)
    end)
    
    if not ok or not encoded then
        addLog("CONFIG", "Gagal memproses data config ke JSON.", Theme.Red)
        return false
    end
    
    local writeOk, err = pcall(function()
        writefile(ConfigManager.FileName, encoded)
    end)
    
    if writeOk then
        ConfigManager.LastActionTime = os.date("%H:%M:%S")
        ConfigManager.StatusMessage = "Tersimpan di workspace: " .. ConfigManager.FileName
        if not silent then
            addLog("CONFIG", "Config tersimpan di workspace [" .. ConfigManager.FileName .. "]", Theme.Green)
        end
        return true
    else
        ConfigManager.StatusMessage = "Gagal simpan: " .. tostring(err)
        addLog("CONFIG", "Gagal menyimpan ke workspace: " .. tostring(err), Theme.Red)
        return false
    end
end

function ConfigManager.Load(silent)
    if not isFsSupported() then
        if not silent then
            addLog("CONFIG", "Workspace file system (readfile) tidak didukung executor ini.", Theme.Red)
        end
        return false
    end
    
    local exists = false
    pcall(function()
        exists = isfile(ConfigManager.FileName)
    end)
    
    if not exists then
        if not silent then
            addLog("CONFIG", "File config belum ditemukan di workspace: " .. ConfigManager.FileName, Theme.TextSecondary)
        end
        ConfigManager.StatusMessage = "File belum dibuat di workspace"
        return false
    end
    
    local readOk, content = pcall(function()
        return readfile(ConfigManager.FileName)
    end)
    
    if not readOk or not content or content == "" then
        addLog("CONFIG", "Gagal membaca isi file config dari workspace.", Theme.Red)
        return false
    end
    
    local decodeOk, decoded = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    
    if not decodeOk or type(decoded) ~= "table" then
        addLog("CONFIG", "Format JSON file config rusak atau tidak valid.", Theme.Red)
        return false
    end
    
    -- Terapkan nilai setting ke State dan UI Toggle
    for key, value in pairs(decoded) do
        if State[key] ~= nil and type(State[key]) == type(value) then
            State[key] = value
            local reg = ConfigManager.RegisteredToggles[key]
            if reg then
                pcall(function()
                    reg.setVisual(value)
                    reg.callback(value)
                end)
            end
        end
    end
    
    ConfigManager.LastActionTime = os.date("%H:%M:%S")
    ConfigManager.StatusMessage = "Dimuat dari workspace: " .. ConfigManager.FileName
    if not silent then
        addLog("CONFIG", "Config berhasil dimuat dari workspace [" .. ConfigManager.FileName .. "]", Theme.Green)
    end
    return true
end

function ConfigManager.Reset(silent)
    local defaults = {
        AutoCollectMoney = false,
        AutoRebirth = false,
        AutoTeleportHalloween = false,
        AutoTrickOrTreat = false,
        AutoClaimHalloweenQuests = false,
        AutoClaimPumpkinPass = false,
        AutoClaimDailyReward = false,
        AutoClaimQuests = false,
        AntiAfk = true,
        AutoSave = true,
        AutoLoad = true,
    }
    
    for key, val in pairs(defaults) do
        State[key] = val
        local reg = ConfigManager.RegisteredToggles[key]
        if reg then
            pcall(function()
                reg.setVisual(val)
                reg.callback(val)
            end)
        end
    end
    
    ConfigManager.Save(true)
    if not silent then
        addLog("CONFIG", "Seluruh konfigurasi di-reset ke nilai default.", Theme.Orange)
    end
end

