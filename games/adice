    [0] = 50000,
    [1] = 5000000,
    [2] = 500000000,
    [3] = 50000000000,
    [4] = 5000000000000,
    [5] = 500000000000000,
    [6] = 1e16,
    [7] = 1e18,
    [8] = 1e20,
    [9] = 1e22,
    [10] = 1e24,
    [11] = 1e26,
    [12] = 1e28,
    [13] = 1e30,
    [14] = 1e32,
    [15] = 1e34,
}

local function formatNumber(val)
    if not val or type(val) ~= "number" then return "0" end
    if val >= 1e30 then return string.format("%.2f No", val / 1e30) end
    if val >= 1e27 then return string.format("%.2f Oc", val / 1e27) end
    if val >= 1e24 then return string.format("%.2f Sp", val / 1e24) end
    if val >= 1e21 then return string.format("%.2f Sx", val / 1e21) end
    if val >= 1e18 then return string.format("%.2f Qi", val / 1e18) end
    if val >= 1e15 then return string.format("%.2f Qa", val / 1e15) end
    if val >= 1e12 then return string.format("%.2f T", val / 1e12) end
    if val >= 1e9  then return string.format("%.2f B", val / 1e9) end
    if val >= 1e6  then return string.format("%.2f M", val / 1e6) end
    if val >= 1e3  then return string.format("%.2f K", val / 1e3) end
    return tostring(math.floor(val))
end

