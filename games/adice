-- 6. ANTI-AFK CONTROLLER (RUNSERVICE HEARTBEAT 10s PULSE + IDLED FALLBACK)
-- =============================================================================
local function setupAntiAfk()
    local vu = nil
    local vim = nil
    pcall(function() vu = game:GetService("VirtualUser") end)
    pcall(function() vim = game:GetService("VirtualInputManager") end)
    
    local lastAfkPulse = tick()
    
    -- Heartbeat pulse berkala setiap 10 detik agar tidak AFK
    RunService.Heartbeat:Connect(function()
        if not State.AntiAfk then return end
        
        local now = tick()
        if (now - lastAfkPulse) >= 10 then
            lastAfkPulse = now
            
            -- Method 1: VirtualUser Click
            if vu then
                pcall(function()
                    vu:CaptureController()
                    vu:ClickButton2(Vector2.new(0, 0))
                end)
            end
            
            -- Method 2: VirtualInputManager key pulse
            if vim then
                pcall(function()
                    vim:SendKeyEvent(true, Enum.KeyCode.F15, false, game)
                    task.spawn(function()
                        task.wait(0.05)
                        vim:SendKeyEvent(false, Enum.KeyCode.F15, false, game)
                    end)
                end)
            end
        end
    end)
    
    -- Fallback: Hook ke event Idled jika client mencapai batas idle
    LocalPlayer.Idled:Connect(function()
        if State.AntiAfk and vu then
            pcall(function()
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(0, 0))
                addLog("ANTI-AFK", "Idled hook triggered - input disimulasikan", Theme.Cyan)
            end)
        end
    end)
    
    addLog("ANTI-AFK", "Anti-AFK Heartbeat controller (10s pulse) siap", Theme.Cyan)
end
setupAntiAfk()

