    toggleBtn.TextSize = 11
    toggleBtn.TextColor3 = defaultVal and Color3.new(1, 1, 1) or Theme.TextSecondary
    applyCorner(toggleBtn, Theme.CornerPill)
    toggleBtn.Parent = card
    
    local active = defaultVal
    local function setVisual(val)
        active = val
        toggleBtn.BackgroundColor3 = active and Theme.ToggleActive or Theme.ToggleInactive
        toggleBtn.Text = active and "ON" or "OFF"
        toggleBtn.TextColor3 = active and Color3.new(1, 1, 1) or Theme.TextSecondary
    end
    
    toggleBtn.MouseButton1Click:Connect(function()
        setVisual(not active)
        if stateKey then
            State[stateKey] = active
        end
        callback(active)
        
        -- Auto-Save saat toggle diubah jika fitur AutoSave aktif
        if State.AutoSave and stateKey and stateKey ~= "AutoSave" and stateKey ~= "AutoLoad" then
            ConfigManager.Save(true)
        end
    end)
    
    if stateKey then
        ConfigManager.RegisterToggle(stateKey, setVisual, callback)
    end
    
    return card, toggleBtn, setVisual
end

